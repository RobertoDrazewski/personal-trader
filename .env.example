# Para desarrollo LOCAL, copiá esto como .env.
# En Railway, estas mismas variables se cargan en el panel de cada servicio
# (Settings > Variables) — NO se sube ningún archivo .env a Railway.

# --- Alpaca ---
APCA_API_KEY_ID=tu_key_id_aca
APCA_API_SECRET_KEY=tu_secret_key_aca
MODE=paper

# --- Símbolos ---
SYMBOLS=AAPL,MSFT,SPY,TSLA,ALB,YPF,GGAL,XOM,CAT

# --- Timeframe ---
TIMEFRAME_MINUTES=15
LOOKBACK_BARS=200

# --- Riesgo ---
MAX_POSITION_PCT=0.08
DAILY_LOSS_LIMIT_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
STOP_LOSS_PCT=0.02
TRAILING_STOP_PCT=0.03
MAX_OPEN_POSITIONS=3

# --- Loop ---
POLL_INTERVAL_SECONDS=60

# --- Filtro de noticias ---
USE_NEWS_FILTER=true
NEWS_NEGATIVE_BLOCK_CONFIDENCE=0.6

# --- LLM: en Railway usá "openai" (no hay GPU para Ollama) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=tu_key_de_openai_aca
OPENAI_MODEL=gpt-4o-mini

# --- Contraseña del dashboard (solo en el servicio "dashboard" de Railway) ---
APP_PASSWORD=elegi_una_contraseña_fuerte_aca

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos ---
# En Railway, esto se autocompleta con una variable de referencia:
# ${{Postgres.DATABASE_URL}}  (lo configurás en el panel, no lo tipeás a mano)
# En local, necesitás un Postgres corriendo (ver README) o usar la URL
# externa que te da Railway para tu base en la nube.
DATABASE_URL=postgresql://usuario:password@localhost:5432/trading_agent
